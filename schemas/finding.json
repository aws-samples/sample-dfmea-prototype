{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfmea.example.com/schemas/finding.json",
  "title": "Finding",
  "description": "A gap or risk finding produced by a specialist agent",
  "type": "object",
  "required": ["finding_id", "review_id", "agent", "finding_type", "description", "action_priority", "confidence"],
  "properties": {
    "finding_id":              {"type": "string"},
    "review_id":               {"type": "string"},
    "agent":                   {"type": "string", "enum": ["failure_mode", "structural", "regulatory", "other", "analyst"]},
    "finding_type":            {"type": "string", "enum": ["missing_failure_mode", "under_scored_risk", "missing_citation", "structural_gap", "interface_gap", "bom_gap", "cad_gap", "custom"]},
    "description":             {"type": "string", "minLength": 10},
    "affected_component":      {"type": "string"},
    "affected_row_number":     {"type": "string"},
    "suggested_failure_mode":  {"type": "string"},
    "severity_suggestion":     {"type": "integer", "minimum": 1, "maximum": 10},
    "occurrence_suggestion":   {"type": "integer", "minimum": 1, "maximum": 10},
    "detection_suggestion":    {"type": "integer", "minimum": 1, "maximum": 10},
    "action_priority":         {"type": "string", "enum": ["High", "Medium", "Low"]},
    "evidence_ids":            {"type": "array", "items": {"type": "string"}},
    "standard_citations":      {"type": "array", "items": {"type": "string"}},
    "confidence":              {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "gap_source":              {"type": "string", "enum": ["kb", "bom_gap", "interface_gap", "cad_gap", "rating_anomaly"]},
    "anchor_ref":              {"type": "string"},
    "created_at":              {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
