# ──────────────────────────────────────────────────────────────────────────────
# DFMEA Deploy Environment Variables
# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# AWS region to deploy into
AWS_DEFAULT_REGION=us-east-1

# Ops / monitoring alert recipient
OPS_EMAIL=ops@yourcompany.com

# Monthly budget alarm threshold in USD (default: 500)
MONTHLY_BUDGET_USD=500

# First Cognito admin user
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=SecurePass#2026!

# HITL reviewer SNS email
REVIEWER_EMAIL=reviewer@yourcompany.com

# Set to 1 if CDK has already been bootstrapped for this account/region
# SKIP_CDK_BOOTSTRAP=0
