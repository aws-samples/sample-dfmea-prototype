{
  "@context": {
    "ont": "https://dfmea.example.com/ontology/v0.1.0#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "hasFunction": {"@id": "ont:hasFunction", "@type": "@id"},
    "hasFailureMode": {"@id": "ont:hasFailureMode", "@type": "@id"},
    "hasCause": {"@id": "ont:hasCause", "@type": "@id"},
    "hasEffect": {"@id": "ont:hasEffect", "@type": "@id"},
    "hasInterface": {"@id": "ont:hasInterface", "@type": "@id"},
    "isMadeOf": {"@id": "ont:isMadeOf", "@type": "@id"},
    "isLocatedIn": {"@id": "ont:isLocatedIn", "@type": "@id"},
    "mustComplyWith": {"@id": "ont:mustComplyWith", "@type": "@id"},
    "connectedVia": {"@id": "ont:connectedVia", "@type": "@id"},
    "severity": {"@id": "ont:severity", "@type": "xsd:integer"},
    "occurrence": {"@id": "ont:occurrence", "@type": "xsd:integer"},
    "detection": {"@id": "ont:detection", "@type": "xsd:integer"},
    "actionPriority": {"@id": "ont:actionPriority"},
    "anchorRef": {"@id": "ont:anchorRef"}
  },
  "@graph": [
    {"@id": "ont:Component",       "@type": "owl:Class", "rdfs:label": "Component",       "rdfs:comment": "A discrete structural or functional part within the assembly."},
    {"@id": "ont:Function",        "@type": "owl:Class", "rdfs:label": "Function",        "rdfs:comment": "An intended behaviour or capability of a Component."},
    {"@id": "ont:Interface",       "@type": "owl:Class", "rdfs:label": "Interface",       "rdfs:comment": "A connection or load path between two Components."},
    {"@id": "ont:FailureMode",     "@type": "owl:Class", "rdfs:label": "FailureMode",     "rdfs:comment": "A way in which a Component or Function can fail."},
    {"@id": "ont:Cause",           "@type": "owl:Class", "rdfs:label": "Cause",           "rdfs:comment": "A root cause leading to a FailureMode."},
    {"@id": "ont:Effect",          "@type": "owl:Class", "rdfs:label": "Effect",          "rdfs:comment": "A downstream consequence of a FailureMode."},
    {"@id": "ont:Standard",        "@type": "owl:Class", "rdfs:label": "Standard",        "rdfs:comment": "A regulatory or OEM standard that applies to a Component."},
    {"@id": "ont:Material",        "@type": "owl:Class", "rdfs:label": "Material",        "rdfs:comment": "A material used in a Component (e.g. UHSS, aluminium alloy)."},
    {"@id": "ont:ThermalZone",     "@type": "owl:Class", "rdfs:label": "ThermalZone",     "rdfs:comment": "A thermal environment zone that affects component behaviour."},
    {"@id": "ont:GeometricRef",    "@type": "owl:Class", "rdfs:label": "GeometricRef",    "rdfs:comment": "A named anchor point extracted from a CAD drawing."},
    {"@id": "ont:JoiningPattern",  "@type": "owl:Class", "rdfs:label": "JoiningPattern",  "rdfs:comment": "A joining method (spot weld, laser weld, adhesive bond, rivet)."},

    {"@id": "ont:Component#B-Pillar_InnerPanel",    "@type": "ont:Component", "rdfs:label": "B-Pillar Inner Panel",    "skos:altLabel": "b_pillar_inner_panel"},
    {"@id": "ont:Component#B-Pillar_OuterPanel",    "@type": "ont:Component", "rdfs:label": "B-Pillar Outer Panel",    "skos:altLabel": "b_pillar_outer_panel"},
    {"@id": "ont:Component#B-Pillar_Reinforcement", "@type": "ont:Component", "rdfs:label": "B-Pillar Reinforcement",  "skos:altLabel": "b_pillar_reinforcement"},
    {"@id": "ont:Component#B-Pillar_Hinge",         "@type": "ont:Component", "rdfs:label": "B-Pillar Hinge",          "skos:altLabel": "b_pillar_hinge"},
    {"@id": "ont:FailureMode#buckling_under_load",  "@type": "ont:FailureMode", "rdfs:label": "Buckling Under Load",    "skos:altLabel": "buckling_under_load"},
    {"@id": "ont:FailureMode#corrosion_at_joint",   "@type": "ont:FailureMode", "rdfs:label": "Corrosion at Joint",     "skos:altLabel": "corrosion_at_joint"},
    {"@id": "ont:FailureMode#weld_fracture",        "@type": "ont:FailureMode", "rdfs:label": "Weld Fracture",          "skos:altLabel": "weld_fracture"},
    {"@id": "ont:Standard#FMVSS_214",               "@type": "ont:Standard",    "rdfs:label": "FMVSS 214 Side Impact",  "skos:altLabel": "fmvss_214"},
    {"@id": "ont:Standard#FMVSS_216",               "@type": "ont:Standard",    "rdfs:label": "FMVSS 216 Roof Crush",   "skos:altLabel": "fmvss_216"},
    {"@id": "ont:Standard#ISO_26262",               "@type": "ont:Standard",    "rdfs:label": "ISO 26262 Functional Safety", "skos:altLabel": "iso_26262"},
    {"@id": "ont:Material#UHSS_1500",               "@type": "ont:Material",    "rdfs:label": "Ultra-High Strength Steel 1500 MPa", "skos:altLabel": "uhss_1500"},
    {"@id": "ont:JoiningPattern#spot_weld",         "@type": "ont:JoiningPattern", "rdfs:label": "Spot Weld",           "skos:altLabel": "spot_weld"},
    {"@id": "ont:JoiningPattern#laser_weld",        "@type": "ont:JoiningPattern", "rdfs:label": "Laser Weld",          "skos:altLabel": "laser_weld"},

    {"@id": "ont:FailureMode#buckling_under_load", "rdfs:subClassOf": {"@id": "ont:FailureMode"}},
    {"@id": "ont:FailureMode#corrosion_at_joint",  "rdfs:subClassOf": {"@id": "ont:FailureMode"}},
    {"@id": "ont:FailureMode#weld_fracture",        "rdfs:subClassOf": {"@id": "ont:FailureMode"}},
    {"@id": "ont:Component#B-Pillar_InnerPanel",
     "hasFailureMode": [{"@id": "ont:FailureMode#buckling_under_load"}, {"@id": "ont:FailureMode#weld_fracture"}],
     "mustComplyWith": [{"@id": "ont:Standard#FMVSS_214"}, {"@id": "ont:Standard#FMVSS_216"}, {"@id": "ont:Standard#ISO_26262"}]},
    {"@id": "ont:Component#B-Pillar_OuterPanel",
     "hasFailureMode": [{"@id": "ont:FailureMode#buckling_under_load"}, {"@id": "ont:FailureMode#corrosion_at_joint"}],
     "mustComplyWith": [{"@id": "ont:Standard#FMVSS_214"}, {"@id": "ont:Standard#FMVSS_216"}, {"@id": "ont:Standard#ISO_26262"}]},
    {"@id": "ont:Component#B-Pillar_Reinforcement",
     "hasFailureMode": [{"@id": "ont:FailureMode#buckling_under_load"}],
     "mustComplyWith": [{"@id": "ont:Standard#FMVSS_214"}, {"@id": "ont:Standard#FMVSS_216"}, {"@id": "ont:Standard#ISO_26262"}]},
    {"@id": "ont:Component#B-Pillar_Hinge",
     "hasFailureMode": [{"@id": "ont:FailureMode#weld_fracture"}, {"@id": "ont:FailureMode#corrosion_at_joint"}],
     "mustComplyWith": [{"@id": "ont:Standard#FMVSS_214"}, {"@id": "ont:Standard#FMVSS_216"}, {"@id": "ont:Standard#ISO_26262"}]}
  ]
}
